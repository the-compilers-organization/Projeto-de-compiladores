{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gcc.exe Compilar e depurar arquivo ativo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/micropascal.exe",
            "args": ["micropascal-compiler/testes/exemplo1.pas"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Habilitar reformatação de impressão para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc.exe arquivo de build ativo"
        }
    ]
}
